# Todas as variáveis são OPCIONAIS em desenvolvimento. Em uso normal cada usuário informa a própria chave
# de API na tela ("Motor de IA"); ela é repassada ao provedor e nunca gravada no servidor.

# --- Armazenamento e acesso ---
# firestore (produção) | file (desenvolvimento, padrão) | memory (testes)
STORE=file
DATA_DIR=data
# Obrigatório em produção: segredo (32+ caracteres) para assinar as sessões.
SESSION_SECRET=
# Primeiro administrador (criado só se ainda não houver usuários).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Administrador

# --- Chaves guardadas no servidor (opcionais; usadas por qualquer usuário autenticado) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelos padrão (o usuário pode sobrescrever na tela).
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1

# Limites
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MIN=15
PROVIDER_TIMEOUT_MS=240000
# PORT é definida automaticamente pelo Cloud Run (padrão local: 8080).
