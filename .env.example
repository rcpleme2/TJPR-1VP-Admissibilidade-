# Todas as variáveis são OPCIONAIS. Em uso normal cada usuário informa a própria chave
# de API na tela ("Motor de IA"); ela é repassada ao provedor e nunca gravada no servidor.

# Protege a aplicação (recomendado em qualquer ambiente exposto à internet).
# Quando definido, a interface pede este token e as rotas /api passam a exigir o cabeçalho x-access-token.
APP_ACCESS_TOKEN=

# Chaves guardadas no servidor (só são usadas se APP_ACCESS_TOKEN estiver definido).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelos padrão (o usuário pode sobrescrever na tela).
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1

# Limites
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MIN=15
PROVIDER_TIMEOUT_MS=240000
# PORT é definida automaticamente pelo Cloud Run (padrão local: 8080).
