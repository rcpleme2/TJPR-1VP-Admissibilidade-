{
  "manifest_version": 3,
  "name": "Admissibilidade 1ª VP",
  "short_name": "Admissibilidade",
  "description": "Abre o sistema de admissibilidade da 1ª Vice-Presidência no painel lateral do Chrome (ou numa janela própria) e recebe PDFs arrastados de outros sites.",
  "version": "1.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png", "128": "icones/128.png" },
  "action": { "default_title": "Abrir o painel de admissibilidade", "default_icon": { "16": "icones/16.png", "32": "icones/32.png" } },
  "side_panel": { "default_path": "painel.html" },
  "background": { "service_worker": "servico.js" },
  "options_ui": { "page": "opcoes.html", "open_in_tab": true },
  "permissions": ["sidePanel", "storage", "contextMenus"],
  "host_permissions": ["https://*.jus.br/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"]
}
